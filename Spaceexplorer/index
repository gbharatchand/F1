 {key:"uranus",render:"uranus",name:"Uranus",type:"Ice giant",fact:"Uranus is icy and spins on its side.",sun:"1.8B miles",earth:"1.6B–1.98B miles",known:"Spins sideways",moons:"27 moons",orbit:590,size:68,c1:"#9be8ff",c2:"#41b7d6"},
 {key:"neptune",render:"neptune",name:"Neptune",type:"Far blue planet",fact:"Neptune is very far from the Sun and has super strong winds.",sun:"2.8B miles",earth:"2.7B–2.9B miles",known:"Strong winds",moons:"14 moons",orbit:680,size:66,c1:"#5e82ff",c2:"#273cb7"}
];
let current=objects[3],angle=-118,drag=false,startX=0,startA=0,muted=false,lastText="";
function show(id){
 ["homeScreen","readyScreen","launchScreen","exploreScreen"].forEach(x=>$("#"+x).classList.toggle("hidden",x!==id));
 $("#topbar").classList.toggle("hidden",id==="homeScreen"||id==="readyScreen"||id==="launchScreen");
}
function stars(){
 const wrap=$("#stars");
 for(let i=0;i<100;i++){
  const s=document.createElement("span");s.className="star";s.style.left=Math.random()*100+"%";s.style.top=Math.random()*100+"%";s.style.animationDelay=(-Math.random()*2.4)+"s";wrap.appendChild(s);
 }
}
let selectedVoice=null;
function pickVoice(){
 if(!("speechSynthesis" in window)) return null;
 const voices=speechSynthesis.getVoices();
 if(!voices.length) return null;
 const en=voices.filter(v=>/^en/i.test(v.lang || ""));
 const preferred=[
   /Google US English/i,
   /Google UK English Female/i,
   /Samantha/i,
   /Karen/i,
   /Microsoft Jenny/i,
   /Microsoft Aria/i
 ];
 for(const re of preferred){
   const match=en.find(v=>re.test(v.name));
   if(match) return match;
 }
 return en[0] || voices[0] || null;
}
if("speechSynthesis" in window){
 selectedVoice=pickVoice();
 speechSynthesis.addEventListener("voiceschanged",()=>{selectedVoice=pickVoice();});
}
function speak(t){
 lastText=t;
 if(muted || !("speechSynthesis" in window)) return;
 speechSynthesis.cancel();
 selectedVoice = selectedVoice || pickVoice();
 const u=new SpeechSynthesisUtterance(t);
 if(selectedVoice) u.voice=selectedVoice;
 u.rate=.84;
 u.pitch=1.15;
 u.volume=1;
 speechSynthesis.speak(u);
}
function planetClass(o){
 return (o.render || o.key) + "Art";
}
function pHTML(o,big=false){
 const size=big?230:o.size;
 const label = big ? "" : `<span class="plabel">${o.name}</span>`;
 const ring = o.rings
   ? `<span class="ring back"></span><span class="ring front"></span>`
   : "";
 const coreClass = `pcore ${planetClass(o)}`;
 let bg = `linear-gradient(135deg,${o.c1},${o.c2})`;
 if(o.key==="sun"){
   bg = "radial-gradient(circle at 38% 28%,rgba(255,255,255,.42) 0 9%,transparent 10%),radial-gradient(circle at 52% 50%,#fff68c 0 18%,#ffd84d 19% 54%,#ff9d23 55% 78%,#ff7b1a 79%)";
 }
 return `<div class="pwrap" style="width:${size}px;height:${size}px">
   ${ring}
   <span class="${coreClass}" style="width:${size}px;height:${size}px;background:${bg}">
     <span class="surface"></span>
     <span class="shine"></span>
     <span class="shadow"></span>
   </span>
   ${label}
 </div>`;
}
function build(){
 const rings=$("#rings"),layer=$("#orbiters");rings.innerHTML="";layer.innerHTML="";
 objects.filter(o=>o.key!=="sun").forEach((o,i)=>{
  const r=document.createElement("div");r.className="orbit";r.style.width=o.orbit*2+"px";r.style.height=o.orbit*1.26+"px";rings.appendChild(r);
  const h=document.createElement("div");h.className="orbiter";h.dataset.orbit=o.orbit;h.dataset.base=[-72,-48,-24,6,28,54,82,112,144][i%9];
  h.innerHTML=`<button class="pbtn">${pHTML(o)}</button>`;
  h.querySelector("button").onclick=e=>{e.stopPropagation();openObj(o)};
  layer.appendChild(h);
 });
 $("#sun").onclick=()=>openObj(objects[0]);
 update();
}
function norm(d){let n=((d%360)+360)%360;if(n>180)n-=360;return n}
function update(){
 const align=Math.abs(norm(angle));const spread=Math.min(align/90,1);
 document.querySelectorAll(".orbiter").forEach(h=>{
  const base=parseFloat(h.dataset.base),orb=parseFloat(h.dataset.orbit);
  const a=(angle+base*spread)*Math.PI/180;
  h.style.transform=`translate(${Math.cos(a)*orb}px,${Math.sin(a)*orb*.42}px)`;
 });
}
function openObj(o){
 $("#loadingText").textContent="Flying to "+o.name+"...";
 $("#loading").classList.remove("hidden");
 setTimeout(()=>{$("#loading").classList.add("hidden");detail(o)},900);
}
function detail(o){
 current=o;
 $("#showcase").innerHTML=pHTML(o,true);
 $("#dName").textContent=o.name;$("#dType").textContent=o.type;$("#dFact").textContent=o.fact;
 $("#dSun").textContent=o.sun;$("#dEarth").textContent=o.earth;$("#dKnown").textContent=o.known;$("#dMoons").textContent=o.moons;
 $("#detail").classList.remove("hidden");
 speak(`This is ${o.name}. ${o.type}. ${o.fact}`);
}
function launch(){
 show("launchScreen");
 const steps=["3","2","1","Blast Off!"];
 steps.forEach((s,i)=>setTimeout(()=>{$("#countText").textContent=s;$("#launchSub").textContent=s==="Blast Off!"?"Let's start exploring!":"Rocket ready on the launch pad…"},i*850));
 setTimeout(()=>{$("#rocket").style.animation="blast 1.5s cubic-bezier(.18,.84,.28,1) forwards";speak("Blast off. Let's start exploring.")},2550);
 setTimeout(()=>{show("exploreScreen");angle=-118;update();speak("Drag left or right to rotate the planets. Tap the Sun or a planet to learn more.")},4100);
}
$("#startBtn").onclick=()=>{show("readyScreen");setTimeout(()=>speak("The astronaut is getting ready to get on the rocket and explore the Solar System."),250)};
$("#launchBtn").onclick=launch;
$("#homeBtn").onclick=()=>show("homeScreen");
$("#muteBtn").onclick=()=>{muted=!muted;$("#muteBtn").textContent=muted?"🔇":"🔊";if(muted&&"speechSynthesis"in window)speechSynthesis.cancel()};
$("#closeBtn").onclick=$("#backBtn").onclick=()=>{$("#detail").classList.add("hidden")};
$("#hearBtn").onclick=()=>speak(`This is ${current.name}. ${current.type}. ${current.fact}`);
$("#nextBtn").onclick=()=>{const i=objects.findIndex(o=>o.key===current.key);openObj(objects[(i+1)%objects.length])};
$("#solar").addEventListener("pointerdown",e=>{if(!$("#detail").classList.contains("hidden")||e.target.closest("button")||e.target.id==="sun")return;drag=true;startX=e.clientX;startA=angle;$("#solar").classList.add("dragging")});
$("#solar").addEventListener("pointermove",e=>{if(!drag)return;angle=startA+(e.clientX-startX)*.35;update()});
function stop(){drag=false;$("#solar").classList.remove("dragging")}
$("#solar").addEventListener("pointerup",stop);$("#solar").addEventListener("pointercancel",stop);
stars();build();
</script>
</body>
</html>
