<script>
const $=s=>document.querySelector(s);
const objects=[
 {key:"sun",render:"sun",name:"Sun",type:"Our nearest star",fact:"The Sun is a star. It gives Earth light and warmth so plants, animals, and people can live.",sun:"It is the Sun",earth:"93M miles",known:"Light and heat",moons:"Not a planet",orbit:0,size:124,c1:"#ffd84d",c2:"#ff7b1a"},
 {key:"mercury",render:"mercury",name:"Mercury",type:"Small rocky planet",fact:"Mercury is closest to the Sun. It is very hot in the day and very cold at night.",sun:"36M miles",earth:"48M–138M miles",known:"Closest to Sun",moons:"0 moons",orbit:130,size:46,c1:"#d6d7dd",c2:"#9a9ca6"},
 {key:"venus",render:"venus",name:"Venus",type:"Cloudy hot planet",fact:"Venus is covered with thick clouds. It is the hottest planet.",sun:"67M miles",earth:"24M–162M miles",known:"Hottest planet",moons:"0 moons",orbit:185,size:58,c1:"#efcaa3",c2:"#d9aa7e"},
