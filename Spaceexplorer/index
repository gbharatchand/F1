<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>Space Explorer Adventure</title>
<style>
@import url("https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&family=Fredoka:wght@500;600;700&display=swap");

*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{width:100%;height:100%;overflow:hidden}
body{
  font-family:"Fredoka",system-ui,sans-serif;
  background:#101a3f;
  color:white;
}
#app{
  position:relative;
  width:100vw;
  height:100vh;
  height:100dvh;
  overflow:hidden;
  background:
    radial-gradient(circle at 18% 18%,rgba(115,217,255,.22),transparent 22%),
    radial-gradient(circle at 78% 16%,rgba(255,92,168,.18),transparent 24%),
    linear-gradient(180deg,#17002d 0%,#1d2478 62%,#243aa5 100%);
}
.screen{
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:16px;
}
.hidden{display:none!important}

.star{
  position:absolute;
  width:4px;height:4px;border-radius:50%;
  background:#dff8ff;
  box-shadow:0 0 12px rgba(255,255,255,.85);
  animation:twinkle 2.4s ease-in-out infinite;
}
@keyframes twinkle{0%,100%{opacity:.25;transform:scale(.7)}50%{opacity:1;transform:scale(1.25)}}
@keyframes floaty{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-14px) rotate(3deg)}}
@keyframes spin{to{transform:rotate(360deg)}}

.topbar{
  position:absolute;
  left:12px;right:12px;top:12px;
  z-index:50;
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.iconBtn{
  border:0;
  width:50px;height:50px;
  border-radius:18px;
  color:white;
  font-size:1.35rem;
  cursor:pointer;
  background:linear-gradient(180deg,#73d9ff,#228de8);
  box-shadow:0 6px 0 #1266b5,0 12px 18px rgba(0,0,0,.25);
}
.iconBtn:active{transform:translateY(4px)}
.modePill{
  padding:10px 16px;
  border-radius:999px;
  background:rgba(255,255,255,.14);
  backdrop-filter:blur(10px);
  font-weight:800;
  box-shadow:inset 0 0 0 2px rgba(255,255,255,.1);
}

/* HOME */
.hero{
  position:relative;
  width:min(1180px,96vw);
  height:min(760px,95vh);
  border-radius:26px;
  overflow:hidden;
  background:
    radial-gradient(circle at 24% 40%,rgba(115,217,255,.18),transparent 28%),
    radial-gradient(circle at 78% 46%,rgba(255,92,168,.16),transparent 24%),
    linear-gradient(180deg,#17002d 0%,#1a1d69 62%,#24297e 100%);
  box-shadow:0 30px 80px rgba(0,0,0,.35);
}
.hero:before{
  content:"";
  position:absolute;inset:0;
  background:
    radial-gradient(circle at 14% 22%,rgba(139,233,255,.9) 0 3px,transparent 4px),
    radial-gradient(circle at 28% 20%,rgba(255,92,168,.5) 0 2px,transparent 3px),
    radial-gradient(circle at 68% 15%,rgba(139,233,255,.82) 0 3px,transparent 4px),
    radial-gradient(circle at 78% 34%,rgba(255,216,77,.65) 0 2px,transparent 3px),
    radial-gradient(circle at 66% 70%,rgba(139,233,255,.85) 0 4px,transparent 5px),
    linear-gradient(170deg,transparent 0 18%,rgba(115,217,255,.10) 19% 23%,transparent 24% 46%,rgba(115,217,255,.09) 47% 51%,transparent 52%);
}
.hero:after{
  content:"";
  position:absolute;
  left:0;right:0;bottom:0;
  height:25%;
  background:linear-gradient(180deg,rgba(14,191,174,0),rgba(14,191,174,.95));
}
.homeCenter{
  position:absolute;
  inset:0;
  z-index:5;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  gap:16px;
  text-align:center;
}
.title{
  font-family:"Baloo 2","Fredoka",sans-serif;
  font-size:clamp(3.4rem,9vw,7.3rem);
  line-height:.78;
  letter-spacing:.03em;
  text-transform:uppercase;
  color:#fffef1;
  text-shadow:
    0 0 8px rgba(255,255,210,.95),
    0 0 18px rgba(180,255,215,.65),
    0 7px 0 rgba(22,72,70,.72),
    0 18px 26px rgba(0,0,0,.38);
}
.title span{display:block}
.subtitle{
  padding:10px 18px;
  border-radius:999px;
  background:rgba(255,255,255,.16);
  font-weight:800;
  color:#eaffff;
  backdrop-filter:blur(10px);
}
.playBtn{
  position:absolute;
  right:8%;
  bottom:12%;
  z-index:8;
  width:126px;height:126px;
  border-radius:50%;
  border:8px solid rgba(255,255,255,.9);
  background:
    radial-gradient(circle at 34% 24%,rgba(255,255,255,.48),transparent 28%),
    linear-gradient(180deg,#22d6c4,#079f8f);
  box-shadow:0 12px 0 #05766c,0 22px 30px rgba(0,0,0,.3);
  cursor:pointer;
}
.playBtn:before{
  content:"";
  position:absolute;
  left:48%;top:50%;
  transform:translate(-36%,-50%);
  border-top:25px solid transparent;
  border-bottom:25px solid transparent;
  border-left:38px solid white;
}
.planet{
  position:absolute;
  z-index:2;
  border-radius:50%;
  animation:floaty 4s ease-in-out infinite;
  filter:drop-shadow(0 0 24px rgba(115,217,255,.35));
}
.earth{
  width:190px;height:190px;left:17%;bottom:10%;
  background:
    radial-gradient(ellipse at 32% 32%,rgba(255,255,255,.4) 0 12%,transparent 13%),
    radial-gradient(ellipse at 36% 48%,#90e36e 0 16%,transparent 17%),
    radial-gradient(ellipse at 62% 58%,#8bdd70 0 19%,transparent 20%),
    linear-gradient(135deg,#8eeaff,#2f91e6);
}
.moon{
  width:118px;height:118px;left:5%;bottom:33%;
  background:
    radial-gradient(circle at 30% 30%,#bbb 0 10%,transparent 11%),
    radial-gradient(circle at 70% 42%,#999 0 9%,transparent 10%),
    radial-gradient(circle at 55% 76%,#888 0 13%,transparent 14%),
    linear-gradient(135deg,#eeeeee,#9d9d9d);
}
.saturn{
  width:230px;height:230px;right:5%;bottom:4%;
  background:
    linear-gradient(10deg,transparent 0 18%,rgba(255,255,255,.22) 19% 24%,transparent 25% 38%,rgba(110,72,30,.18) 39% 44%,transparent 45% 62%,rgba(255,255,255,.20) 63% 69%,transparent 70%),
    linear-gradient(135deg,#f7c76e,#c27c34);
}
.saturn:after{
  content:"";
  position:absolute;left:-44%;right:-44%;top:43%;height:22%;
  border:10px solid rgba(219,255,139,.72);
  border-top-color:rgba(219,255,139,.35);
  border-radius:50%;
  transform:rotate(-18deg);
}
.bluePlanet{
  width:172px;height:172px;right:1%;top:0;
  background:
    radial-gradient(ellipse at 35% 30%,rgba(255,255,255,.25) 0 14%,transparent 15%),
    linear-gradient(135deg,#41b7d6,#1e638d);
}
.purplePlanet{
  width:142px;height:142px;right:0;top:36%;
  background:
    radial-gradient(ellipse at 70% 26%,rgba(255,255,255,.30) 0 12%,transparent 13%),
    linear-gradient(135deg,#de70d6,#8134a4);
}

/* READY */
.card{
  position:relative;
  width:min(980px,96vw);
  height:min(650px,92vh);
  border-radius:38px;
  padding:26px;
  overflow:hidden;
  background:rgba(255,255,255,.1);
  border:4px solid rgba(255,255,255,.14);
  box-shadow:0 28px 70px rgba(0,0,0,.26);
}
.card:after{
  content:"";
  position:absolute;left:-10%;right:-10%;bottom:-14%;height:28%;
  background:linear-gradient(180deg,rgba(255,255,255,.08),transparent 25%),linear-gradient(180deg,#1fcfc0,#0ebfae);
  border-radius:50% 50% 0 0;
}
.cardTitle{
  position:relative;z-index:3;text-align:center;
  font-family:"Baloo 2","Fredoka",sans-serif;
  font-size:clamp(2rem,6vw,3.3rem);
  text-shadow:0 5px 14px rgba(0,0,0,.22);
}
.cardSub{
  position:relative;z-index:3;text-align:center;color:#e6f8ff;font-weight:800;margin-top:8px;
}
.readyLayout{
  position:relative;z-index:3;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:24px;
  align-items:center;
  height:calc(100% - 70px);
  margin-top:20px;
}
.readyScene{
  min-height:470px;
  border-radius:34px;
  background:radial-gradient(circle at 50% 45%,rgba(115,217,255,.16),transparent 46%),rgba(255,255,255,.08);
  border:3px solid rgba(255,255,255,.12);
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
}
.readyScene:before{
  content:"";
  position:absolute;
  width:72%;
  aspect-ratio:1;
  border-radius:50%;
  border:2px dashed rgba(255,255,255,.12);
  animation:spin 20s linear infinite;
}
.astro{
  position:relative;
  width:250px;height:330px;
  filter:drop-shadow(0 20px 24px rgba(0,0,0,.30));
  animation:floaty 3s ease-in-out infinite;
}
.helmet{
  position:absolute;left:50%;top:8px;width:138px;height:138px;transform:translateX(-50%);
  border-radius:50%;
  background:
    radial-gradient(circle at 70% 34%,rgba(255,255,255,.75) 0 7%,transparent 8%),
    radial-gradient(circle at 43% 60%,rgba(255,255,255,.42) 0 8%,transparent 9%),
    linear-gradient(135deg,#28205f 0%,#090522 68%);
  border:10px solid #fff;
  box-shadow:inset 0 0 0 6px rgba(107,97,162,.35),0 0 0 4px rgba(45,38,120,.42);
  z-index:6;
}
.helmet:before{content:"";position:absolute;left:-8px;top:22px;width:36px;height:46px;border-radius:50%;background:#fff}
.helmet:after{content:"";position:absolute;right:18px;top:10px;width:54px;height:16px;border-radius:999px;background:rgba(255,255,255,.88);transform:rotate(-18deg)}
.bodySuit{
  position:absolute;left:50%;top:132px;width:118px;height:122px;transform:translateX(-50%) rotate(6deg);
  border-radius:38px 38px 30px 30px;background:#fff;
  box-shadow:inset -10px -10px 0 rgba(100,100,150,.18);
  z-index:4;
}
.bodySuit:before{
  content:"";position:absolute;left:50%;top:38px;width:44px;height:34px;transform:translateX(-50%);
  border-radius:11px;background:#e9f7ff;border:4px solid #243269;box-shadow:inset 0 0 0 5px #48c8ff;
}
.arm,.leg{position:absolute;background:#fff;border-radius:999px;box-shadow:inset -6px -6px 0 rgba(100,100,150,.18);z-index:3}
.armL{width:42px;height:98px;left:42px;top:140px;transform:rotate(34deg)}
.armR{width:42px;height:98px;right:40px;top:145px;transform:rotate(-22deg)}
.legL{width:42px;height:104px;left:86px;top:240px;transform:rotate(22deg)}
.legR{width:42px;height:104px;right:78px;top:238px;transform:rotate(-18deg)}
.jet{
  position:absolute;left:32px;top:230px;width:50px;height:128px;border-radius:50%;
  background:linear-gradient(180deg,#fff58a,#ffd84d,#ff8a3d,transparent);
  filter:blur(5px);transform:rotate(36deg);z-index:1;
}
.readyText{
  color:#173b5f;
  background:rgba(255,255,255,.96);
  border-radius:34px;
  padding:26px;
  border:4px solid rgba(255,255,255,.75);
  box-shadow:0 18px 36px rgba(0,0,0,.22);
}
.readyText h2{font-family:"Baloo 2";color:#456b92;font-size:2.1rem}
.readyText p{margin:12px 0 20px;color:#405d74;font-weight:800;line-height:1.4}
.launchBtn{
  border:0;border-radius:999px;padding:14px 20px;cursor:pointer;color:#fff;
  font-weight:900;font-size:1rem;
  background:linear-gradient(180deg,#8fea55,#3caf32);
  box-shadow:0 6px 0 #267929;
}

/* LAUNCH */
.launchScene{position:relative;z-index:3;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:40px}
.count{font-family:"Baloo 2";font-size:clamp(2.8rem,8vw,5rem);text-shadow:0 8px 18px rgba(0,0,0,.3)}
.launchSky{position:relative;width:100%;height:430px;display:flex;align-items:flex-end;justify-content:center}
.pad{position:absolute;bottom:0;width:260px;height:52px;border-radius:50% 50% 20px 20px;background:linear-gradient(180deg,#9ba8bf,#5f6d84);box-shadow:0 16px 0 rgba(0,0,0,.16)}
.rocket{
  position:absolute;bottom:36px;width:92px;height:210px;transform-origin:center bottom;
  filter:drop-shadow(0 18px 18px rgba(0,0,0,.24));
  animation:rocketReady 1.25s ease-in-out infinite;
}
.rocketNose{position:absolute;left:50%;top:0;width:62px;height:64px;transform:translateX(-50%);border-radius:50% 50% 16px 16px;background:linear-gradient(180deg,#ff5ca8,#d83778)}
.rocketBody{position:absolute;left:50%;top:45px;width:72px;height:118px;transform:translateX(-50%);border-radius:34px 34px 18px 18px;background:linear-gradient(180deg,#fff,#e8eef7)}
.rocketWindow{position:absolute;left:50%;top:68px;width:34px;height:34px;transform:translateX(-50%);border-radius:50%;background:#73d9ff;border:6px solid #456b92;z-index:3}
.fin{position:absolute;bottom:40px;width:32px;height:54px;background:#ff8a3d;border-radius:18px 18px 8px 8px;z-index:-1}
.finL{left:-2px;transform:rotate(25deg)}.finR{right:-2px;transform:rotate(-25deg)}
.flame{position:absolute;left:50%;bottom:-52px;width:40px;height:64px;transform:translateX(-50%);border-radius:50%;background:linear-gradient(180deg,#fff68c,#ffd84d,#ff8a3d,transparent);filter:blur(2px);animation:flame .18s ease-in-out infinite alternate}
@keyframes rocketReady{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@keyframes flame{from{transform:translateX(-50%) scaleY(.85)}to{transform:translateX(-50%) scaleY(1.15)}}
@keyframes blast{0%{transform:translateY(0) scale(1)}22%{transform:translateY(-22px) scale(1.02)}100%{transform:translateY(-720px) scale(1.12)}}

/* EXPLORE */
.explore{
  position:relative;
  width:min(1180px,97vw);
  height:min(760px,96vh);
  border-radius:38px;
  overflow:hidden;
  background:rgba(255,255,255,.08);
  border:4px solid rgba(255,255,255,.12);
  box-shadow:0 28px 70px rgba(0,0,0,.28);
}
.hint{
  position:absolute;top:74px;left:50%;transform:translateX(-50%);z-index:18;
  padding:9px 14px;border-radius:999px;background:rgba(255,255,255,.92);color:#17406b;font-weight:900;
}
.solar{position:absolute;inset:0;touch-action:none;cursor:grab}
.solar.dragging{cursor:grabbing}
.sun,.orbit,.orbiter{position:absolute;left:27%;top:54%}
.sun{
  width:124px;height:124px;border-radius:50%;transform:translate(-50%,-50%);z-index:20;cursor:pointer;
  background:
    radial-gradient(circle at 38% 28%,rgba(255,255,255,.42) 0 9%,transparent 10%),
    radial-gradient(circle at 52% 50%,#fff68c 0 18%,#ffd84d 19% 54%,#ff9d23 55% 78%,#ff7b1a 79%);
  filter:drop-shadow(0 0 20px rgba(255,216,77,.48));
}
.orbit{border:2px dashed rgba(255,255,255,.09);border-radius:50%;transform:translate(-50%,-50%);pointer-events:none}
.orbiter{width:0;height:0;transform-origin:0 0}
.pbtn{
  position:absolute;left:0;top:0;transform:translate(-50%,-50%);
  border:0;background:none;cursor:pointer;filter:drop-shadow(0 16px 16px rgba(0,0,0,.26));
}
.pcore{
  position:relative;border-radius:50%;
  display:block;
  box-shadow:inset -12px -14px 0 rgba(0,0,0,.18),inset 8px 8px 14px rgba(255,255,255,.15),0 10px 16px rgba(0,0,0,.18);
}
.pcore:before{content:"";position:absolute;left:18%;top:10%;width:26%;height:16%;border-radius:999px;background:rgba(255,255,255,.28);transform:rotate(-18deg)}
.plabel{
  position:absolute;left:50%;top:calc(100% + 10px);transform:translateX(-50%);
  padding:5px 9px;border-radius:999px;background:rgba(255,255,255,.9);color:#17406b;font-weight:900;font-size:.78rem;white-space:nowrap
}
.ring{position:absolute;left:-42%;right:-42%;top:41%;height:22%;border-radius:50%;border:7px solid rgba(255,244,214,.86);border-top-color:rgba(255,244,214,.42);transform:rotate(-16deg);z-index:3}
.detail{
  position:absolute;inset:74px 10px 10px 10px;z-index:50;display:grid;
  grid-template-columns:minmax(280px,42%) minmax(320px,1fr);gap:18px;
  background:linear-gradient(90deg,rgba(13,11,75,.76),rgba(13,11,75,.42));backdrop-filter:blur(8px);
  border-radius:34px;padding:18px;
}
.showcase{border-radius:34px;background:rgba(255,255,255,.08);border:3px solid rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center}
.info{
  border-radius:34px;background:rgba(255,255,255,.97);color:#173b5f;padding:20px;border:4px solid rgba(255,255,255,.74);
}
.info h2{font-family:"Baloo 2";color:#456b92;font-size:clamp(2rem,5vw,3rem)}
.tag{display:inline-flex;margin-top:8px;padding:7px 11px;border-radius:999px;background:#eef8ff;color:#31526a;font-weight:850}
.fact{margin-top:10px;padding:14px;border-radius:24px;background:#f4fbff;color:#405d74;font-weight:800;line-height:1.38}
.factGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:14px}
.fp{min-height:72px;border-radius:22px;padding:10px 12px;background:linear-gradient(180deg,#fff,#f1faff);box-shadow:inset 0 0 0 2px rgba(210,236,255,.75)}
.fp small{display:block;color:#6a86a0;font-weight:900;font-size:.78rem;text-transform:uppercase}
.fp b{display:block;color:#174ab6;font-family:"Baloo 2";font-size:1.15rem;margin-top:3px}
.close{position:absolute;right:18px;top:18px;border:0;border-radius:18px;width:50px;height:50px;background:linear-gradient(180deg,#ff8fbd,#ee3e83);color:#fff;font-weight:900;font-size:1.2rem;box-shadow:0 6px 0 #b82062}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.small{border:0;border-radius:999px;padding:10px 14px;font-weight:900;color:#fff;background:linear-gradient(180deg,#73d9ff,#228de8);box-shadow:0 5px 0 #1266b5}
.green{background:linear-gradient(180deg,#8fea55,#3caf32);box-shadow:0 5px 0 #267929}
.orange{background:linear-gradient(180deg,#ffd84d,#ff8a3d);box-shadow:0 5px 0 #c76824}
.loading{position:absolute;inset:0;z-index:70;background:linear-gradient(180deg,rgba(13,11,75,.86),rgba(21,31,115,.92));display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16px}
.shooting{position:relative;width:min(620px,82vw);height:180px}
.shoot{position:absolute;left:-60px;top:90px;width:24px;height:24px;background:radial-gradient(circle,#fff9b4 0 26%,#ffd84d 27% 62%,transparent 63%);border-radius:50%;animation:shoot 1.1s ease-in-out infinite}
.shoot:after{content:"";position:absolute;right:10px;top:8px;width:150px;height:8px;border-radius:999px;background:linear-gradient(90deg,transparent,rgba(139,233,255,.45),#fff);transform:rotate(-12deg)}
@keyframes shoot{0%{transform:translate(0,0) scale(.6);opacity:0}12%{opacity:1}100%{transform:translate(620px,-110px) scale(1.08);opacity:0}}

@media(max-width:820px){
  .readyLayout{grid-template-columns:1fr;gap:14px}
  .readyScene{min-height:300px}
  .readyText{padding:18px}
  .astro{transform:scale(.78)}
  .sun,.orbit,.orbiter{left:33%}
  .detail{grid-template-columns:1fr;grid-template-rows:38% 1fr}
  .factGrid{gap:7px}
}

/* V14 richer planet art + previous voice settings */
.pwrap{
  position:relative;
  display:block;
}
.pcore{
  overflow:hidden;
}
.pcore .surface{
  position:absolute;
  inset:0;
  border-radius:50%;
  pointer-events:none;
}
.pcore .shine{
  position:absolute;
  left:16%;
  top:10%;
  width:30%;
  height:18%;
  border-radius:999px;
  background:rgba(255,255,255,.35);
  transform:rotate(-20deg);
  pointer-events:none;
}
.pcore .shadow{
  position:absolute;
  inset:0;
  border-radius:50%;
  background:radial-gradient(circle at 28% 24%, transparent 0 42%, rgba(0,0,0,.18) 74%, rgba(0,0,0,.30) 100%);
  pointer-events:none;
}
.pcore.sunArt{
  box-shadow:0 0 24px rgba(255,216,77,.46), inset -12px -14px 0 rgba(0,0,0,.08), inset 8px 8px 14px rgba(255,255,255,.22), 0 10px 16px rgba(0,0,0,.18);
}
.pcore.jupiterArt .surface{
  background:
    linear-gradient(0deg,
      rgba(130,80,40,.25) 0 10%,
      transparent 11% 20%,
      rgba(255,255,255,.24) 21% 28%,
      transparent 29% 41%,
      rgba(130,80,40,.22) 42% 52%,
      transparent 53% 62%,
      rgba(255,255,255,.18) 63% 70%,
      transparent 71%),
    radial-gradient(ellipse at 64% 62%, #c44f3d 0 8%, transparent 9%);
}
.pcore.earthArt .surface{
  background:
    radial-gradient(ellipse at 34% 42%, #68d06b 0 16%, transparent 17%),
    radial-gradient(ellipse at 62% 58%, #69c864 0 18%, transparent 19%),
    radial-gradient(ellipse at 56% 27%, #72d26f 0 10%, transparent 11%),
    radial-gradient(ellipse at 28% 24%, rgba(255,255,255,.36) 0 10%, transparent 11%);
}
.pcore.venusArt .surface{
  background:
    radial-gradient(ellipse at 18% 34%, rgba(255,255,255,.18) 0 10%, transparent 11%),
    radial-gradient(ellipse at 70% 26%, rgba(255,255,255,.14) 0 12%, transparent 13%),
